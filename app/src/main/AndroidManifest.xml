<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="36" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Used by the foreground launch-app picker and the notification allowlist. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- The module's own link to the TX lamp hoist; never used for the vehicle, which Ninebot owns. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Before Android 12 the install-time Bluetooth pair connects and a BLE scan needs fine location; the module never reads the position. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <!-- Putting the media volume back after a key press the lamp took. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <queries>
        <package android:name="cn.ninebot.ninebot" />
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
    </queries>
    <application android:forceQueryable="true" android:label="Ninebot Enhance" android:description="@string/module_description"
        android:icon="@android:drawable/sym_def_app_icon" android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="false">
        <!-- The launcher entry only offers the system pages (autostart, notification access); the private activities below are opened through immutable module PendingIntents. -->
        <activity android:name=".ui.ModuleActivity" android:exported="true" android:label="Ninebot Enhance" android:excludeFromRecents="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" /></intent-filter>
        </activity>
        <activity android:name=".ui.SetupGuideActivity" android:exported="false"
            android:excludeFromRecents="true" />
        <activity android:name=".ui.LaunchAppPickerActivity" android:exported="false"
            android:excludeFromRecents="true" />
        <activity android:name=".ui.NotificationSettingsActivity" android:exported="false"
            android:excludeFromRecents="true" />
        <activity android:name=".ui.LampSettingsActivity" android:exported="false"
            android:excludeFromRecents="true" />
        <activity android:name=".ui.BmsSettingsActivity" android:exported="false"
            android:excludeFromRecents="true" />
        <activity android:name=".ui.TouchSettingsActivity" android:exported="false"
            android:excludeFromRecents="true" />
        <service android:name=".notification.MirrorNotificationListener" android:exported="true"
            android:label="Ninebot Enhance" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <activity android:name=".ui.ScreenCaptureConsentActivity" android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true"
            android:resizeableActivity="true" />
        <service android:name=".service.ScreenCaptureService" android:exported="false" android:foregroundServiceType="mediaProjection" />
        <service android:name=".service.FrameBridgeService" android:exported="true" />
        <provider android:name=".service.LogShareProvider"
            android:authorities="dev.ichinomiya.ninebotenhance.logs"
            android:exported="false" android:grantUriPermissions="true" />
        <provider android:name=".service.RootBridgeProvider" android:authorities="dev.ichinomiya.ninebotenhance.root" android:exported="true" />
        <provider android:name=".service.NaviContentProvider" android:authorities="dev.ichinomiya.ninebotenhance.navi" android:exported="true" />
        <provider android:name=".service.CompatibilityProvider" android:authorities="dev.ichinomiya.ninebotenhance.compatibility" android:exported="true" />
        <provider android:name="rikka.shizuku.ShizukuProvider" android:authorities="dev.ichinomiya.ninebotenhance.shizuku"
            android:exported="true" android:multiprocess="false" android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
